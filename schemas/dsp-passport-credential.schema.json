{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lead-project.xyz/schemas/dsp-passport-credential.schema.json",
  "title": "DSP-Passport Credential",
  "description": "W3C Verifiable Credential based electronic passport for Physical AI units operating in public or shared spaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "@context",
    "type",
    "id",
    "issuer",
    "issuanceDate",
    "credentialSubject",
    "proof"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^dsp-passport@\\d+\\.\\d+$",
      "description": "Schema version identifier, e.g. dsp-passport@1.0"
    },
    "@context": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "JSON-LD contexts, typically W3C VC context and DSP context."
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Credential types, e.g. VerifiableCredential and DSPPhysicalAIPassport."
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for this credential."
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:dsp:[A-Za-z0-9:_\\-.]+$",
      "description": "Issuer DID, typically a certifier."
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time",
      "description": "Credential issuance timestamp."
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time",
      "description": "Optional credential expiration timestamp."
    },
    "revocationEndpoint": {
      "type": "string",
      "format": "uri",
      "description": "Optional endpoint to check revocation status."
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robotDid",
        "manufacturer",
        "model",
        "safetyClearance",
        "responsibility",
        "socialReturn"
      ],
      "properties": {
        "robotDid": {
          "type": "string",
          "pattern": "^did:dsp:robot:[A-Za-z0-9\\-_.]+$",
          "description": "DID of the Physical AI unit."
        },
        "agentDid": {
          "type": "string",
          "pattern": "^did:dsp:agent:[A-Za-z0-9\\-_.]+$",
          "description": "Optional DID of the AI Agent associated with the unit."
        },
        "manufacturer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "did"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "did": {
              "type": "string",
              "pattern": "^did:dsp:manufacturer:[A-Za-z0-9\\-_.]+$"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "safetyClearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "status",
            "validUntil",
            "operationalZones"
          ],
          "properties": {
            "phase": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "Certification phase, typically 1 to 3. 0 may indicate pre-certification."
            },
            "status": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "SUSPENDED",
                "REVOKED",
                "EXPIRED"
              ]
            },
            "validFrom": {
              "type": "string",
              "format": "date-time"
            },
            "validUntil": {
              "type": "string",
              "format": "date-time"
            },
            "operationalZones": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Permitted operational zones, e.g. urban-pedestrian or indoor-commercial."
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxSpeedMps": {
                  "type": "number",
                  "minimum": 0
                },
                "requiresRemoteStop": {
                  "type": "boolean"
                },
                "requiresHumanOverride": {
                  "type": "boolean"
                },
                "requiresSafetyGateway": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "responsibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operatorDid",
            "certifierDid"
          ],
          "properties": {
            "operatorDid": {
              "type": "string",
              "pattern": "^did:dsp:operator:[A-Za-z0-9\\-_.]+$"
            },
            "maintainerDid": {
              "type": "string",
              "pattern": "^did:dsp:maintainer:[A-Za-z0-9\\-_.]+$"
            },
            "certifierDid": {
              "type": "string",
              "pattern": "^did:dsp:certifier:[A-Za-z0-9\\-_.]+$"
            },
            "insurance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "providerDid": {
                  "type": "string",
                  "pattern": "^did:dsp:insurer:[A-Za-z0-9\\-_.]+$"
                },
                "providerName": {
                  "type": "string"
                },
                "policyId": {
                  "type": "string"
                },
                "validUntil": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverageMinorUnits": {
                  "type": "integer",
                  "minimum": 0
                },
                "currencyCode": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{3,10}$"
                }
              }
            }
          }
        },
        "socialReturn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activeCareSlot",
            "participationStatus",
            "ruleId"
          ],
          "properties": {
            "activeCareSlot": {
              "type": "string",
              "description": "Identifier for the active Social Return target, e.g. DogPension_v1."
            },
            "contributionRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "participationStatus": {
              "type": "string",
              "enum": [
                "opt_in",
                "opt_out",
                "mandatory",
                "not_applicable"
              ]
            },
            "ruleId": {
              "type": "string"
            },
            "socialReturnSafetyGateRequired": {
              "type": "boolean",
              "description": "Whether Social Return execution must pass through a Social Return Safety Gate."
            }
          }
        },
        "privacyLevel": {
          "type": "string",
          "enum": [
            "public",
            "aggregated",
            "anonymized",
            "private"
          ]
        }
      }
    },
    "proof": {
      "$ref": "#/definitions/proof"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Ed25519Signature2020",
            "RsaSignature2018",
            "EcdsaSecp256k1Signature2019",
            "DataIntegrityProof"
          ]
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        },
        "proofPurpose": {
          "type": "string"
        },
        "proofValue": {
          "type": "string"
        }
      }
    }
  }
}
