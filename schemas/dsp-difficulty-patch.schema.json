{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lead-project.xyz/schemas/dsp-difficulty-patch.schema.json",
  "title": "DSP-Difficulty Patch",
  "description": "Non-personal traversal difficulty and coexistence stress patch for Physical AI navigation. Uses spatial indexing (e.g., H3) and aggregated metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patchId",
    "providerDid",
    "location",
    "timestamp",
    "difficulty",
    "coexistence",
    "privacy",
    "provenance",
    "proof"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^dsp-diff@\\d+\\.\\d+$",
      "description": "Schema version identifier, e.g. dsp-diff@1.0"
    },
    "patchId": {
      "type": "string",
      "description": "Unique identifier for this difficulty patch."
    },
    "providerDid": {
      "type": "string",
      "pattern": "^did:dsp:robot:[A-Za-z0-9\\-_.]+$",
      "description": "DID of the reporting Physical AI unit."
    },
    "agentDid": {
      "type": "string",
      "pattern": "^did:dsp:agent:[A-Za-z0-9\\-_.]+$",
      "description": "Optional DID of the AI Agent coordinating the reporting unit."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexType",
        "indexValue",
        "resolution"
      ],
      "properties": {
        "indexType": {
          "type": "string",
          "enum": [
            "H3",
            "S2",
            "quadkey",
            "geohash",
            "mesh"
          ],
          "description": "Spatial indexing scheme used."
        },
        "indexValue": {
          "type": "string",
          "description": "Spatial index string, e.g. H3 index."
        },
        "resolution": {
          "type": "string",
          "description": "Resolution descriptor, e.g. H3 level 10 or 10m."
        },
        "regionHint": {
          "type": "string",
          "description": "Optional coarse region descriptor, e.g. tokyo_shibuya."
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the patch was captured or aggregated."
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceType",
        "surfaceConfidence",
        "obstacleDensity",
        "slopeIndex",
        "curbRisk",
        "traversalDifficultyScore"
      ],
      "properties": {
        "surfaceType": {
          "type": "string",
          "enum": [
            "paved_even",
            "paved_uneven",
            "gravel",
            "dirt",
            "grass",
            "wet",
            "icy",
            "mixed",
            "unknown"
          ]
        },
        "surfaceConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "obstacleDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "slopeIndex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "curbRisk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "crowdDensityLevel": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "severe"
          ]
        },
        "weatherImpact": {
          "type": "string",
          "enum": [
            "none",
            "light",
            "moderate",
            "severe"
          ]
        },
        "traversalDifficultyScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "coexistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carePriorityScore",
        "coexistenceScore",
        "serviceAnimalEncounter",
        "yieldFrequency"
      ],
      "properties": {
        "carePriorityScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Degree of consideration required for vulnerable pedestrians or service animals."
        },
        "coexistenceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ease of harmonious coexistence in this spatial segment."
        },
        "coexistenceStressIndex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Environmental/biological tension or friction experienced."
        },
        "serviceAnimalEncounter": {
          "type": "boolean",
          "description": "Whether guide dogs, service dogs, or companion animals were encountered."
        },
        "yieldFrequency": {
          "type": "number",
          "minimum": 0,
          "description": "Yield actions executed per 100 meters traversed."
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noBiometricData",
        "noRawFootage",
        "quantizedSpatialOnly"
      ],
      "properties": {
        "noBiometricData": {
          "type": "boolean"
        },
        "noRawFootage": {
          "type": "boolean"
        },
        "quantizedSpatialOnly": {
          "type": "boolean"
        },
        "teeProcessed": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensorSuite",
        "hardwareIntegrityProof"
      ],
      "properties": {
        "sensorSuite": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hardwareIntegrityProof": {
          "type": "string"
        },
        "firmwareVersion": {
          "type": "string"
        }
      }
    },
    "proof": {
      "$ref": "#/definitions/proof"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "definitions": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Ed25519Signature2020",
            "RsaSignature2018",
            "EcdsaSecp256k1Signature2019",
            "DataIntegrityProof"
          ]
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        },
        "proofPurpose": {
          "type": "string"
        },
        "proofValue": {
          "type": "string"
        }
      }
    }
  }
}
